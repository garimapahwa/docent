# Solana RPC endpoint. The public endpoint works but is heavily rate limited;
# a free Helius URL (https://mainnet.helius-rpc.com/?api-key=...) is recommended.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: ElevenLabs key for the video narration. Needs the Text to Speech permission.
ELEVENLABS_API_KEY=
# Optional overrides for the narrator voice and model.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# Reserved for the AI storyboard step (not used yet).
ANTHROPIC_API_KEY=
